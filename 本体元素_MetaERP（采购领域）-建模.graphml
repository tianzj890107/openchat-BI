  <data key="d1">采购验收编号</data>
  <data key="d2">acNumber</data>
  <data key="d3">采购验收编号 (acNumber)</data>
  <data key="d4">用于界面展示、对账及与外部系统交互时的业务编号。</data>
</node>
<node id="AT0000783">
  <data key="d0">business_attribute</data>
  <data key="d1">采购会计事件ID</data>
  <data key="d2">acEventId</data>
  <data key="d3">采购会计事件ID (acEventId)</data>
  <data key="d4">通常关联主数据或业务单据内部标识。</data>
</node>
