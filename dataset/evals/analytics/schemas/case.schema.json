{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://boulderaitech.local/eimosp-ontology-agentic-analytics/analytics-eval-case.schema.json",
  "title": "Analytics golden-set case",
  "description": "One natural-language -> intent -> contract -> query -> number -> evidence -> chart -> answer contract. Cases are generated by dataset/evals/analytics/build_cases.py; the JSON is committed so a reviewer can read a single case without running anything. Unknown top-level fields are rejected (build_cases fails, and the runner marks the case failed) so a misspelled key can never be silently ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "version",
    "priority",
    "suite",
    "domain",
    "category",
    "evaluator",
    "question",
    "conversation",
    "context",
    "fixture",
    "expected",
    "forbidden",
    "evidence_requirements",
    "tags"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^ANA(-[A-Z0-9]+)+-[0-9]{3}$",
      "description": "Stable identity. Never renumber an existing case; add a new one instead."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "suite": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "smoke",
          "regression",
          "multi-turn",
          "ontology",
          "charts",
          "adversarial",
          "recovery",
          "diagnosis",
          "recorded-provider",
          "live",
          "live-canary"
        ]
      },
      "uniqueItems": true
    },
    "domain": {
      "enum": [
        "采购",
        "库存",
        "销售",
        "财务",
        "质量",
        "制造",
        "通用"
      ]
    },
    "category": {
      "enum": [
        "intent",
        "facts",
        "metrics",
        "comparison",
        "trend",
        "anomaly",
        "diagnosis",
        "recommendation",
        "ontology",
        "multi_turn",
        "charts",
        "failure_recovery",
        "adversarial"
      ]
    },
    "evaluator": {
      "enum": [
        "policy",
        "sql",
        "ontology",
        "multi_turn",
        "chart_validate",
        "chart_policy",
        "chart_html_safety",
        "sql_guard",
        "recovery_state",
        "admission",
        "session_isolation",
        "live",
        "recorded_provider",
        "generated_sql",
        "tool_chain",
        "answer_grounding",
        "context_resolution",
        "recorded_session_isolation"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "time_range": {
          "type": "object"
        },
        "organization": {
          "type": "array"
        },
        "currency": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "fixture": {
      "type": "object",
      "description": "Declarative inputs for the evaluator. Must reference only files under dataset/evals/analytics/fixtures/.",
      "properties": {
        "db": {
          "type": "string",
          "description": "SQLite fixture name, opened read-only (mode=ro&immutable=1)."
        },
        "sql": {
          "type": "string",
          "description": "Reference query. Must not contain DDL/DML."
        },
        "ontology": {
          "type": "string"
        },
        "script": {
          "type": "array"
        },
        "env": {
          "type": "object"
        },
        "principals": {
          "type": "object"
        },
        "previous_contract": {
          "type": "object"
        },
        "resolution": {
          "type": "object"
        },
        "resolved_contract": {
          "type": "object"
        },
        "effective_question": {
          "type": "string"
        },
        "follow_up_question": {
          "type": "string"
        },
        "resolved_question": {
          "type": "string"
        },
        "chart": {
          "type": "object"
        },
        "html": {
          "type": "string"
        },
        "rows": {
          "type": "array"
        },
        "columns": {
          "type": "array"
        },
        "provider": {
          "type": "string",
          "description": "Recorded-provider transcript, relative to dataset/evals/analytics/. Replayed through the production turn loop; no model call is made."
        },
        "reference_sql": {
          "type": "string",
          "description": "Reference query for generated_sql cases, executed read-only alongside the SQL the agent actually issued."
        },
        "tools_override": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous": {
          "type": "object",
          "description": "Inherited AnalysisContext (context_resolution)."
        },
        "changes": {
          "type": "object",
          "description": "Explicit scope changes the follow-up states (context_resolution)."
        },
        "cross_domain_reason": {
          "type": "string",
          "description": "Reviewed justification for a case whose SQL fixture DB is intentionally from another domain (e.g. an ontology term case that only needs any read-only DB)."
        },
        "chart_params": {
          "type": "object",
          "description": "Pre-built chart parameters for chart_validate/chart_policy cases."
        },
        "title": {
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "minItems": 2,
          "description": "Two or more independent sessions, each with its own recorded transcript.  Replayed through the real turn loop; used by recorded_session_isolation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provider"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "data",
                  "report"
                ]
              },
              "group": {
                "type": "string",
                "description": "Sessions sharing a group value run in one WebSession, in declared order; different groups are fully isolated."
              }
            }
          }
        },
        "share_session": {
          "type": "boolean",
          "description": "True when the listed turns belong to ONE declared conversation group: inheritance must then happen, in order."
        },
        "share_conversation_store": {
          "type": "boolean",
          "description": "True when all sessions write into one ConversationStore (same user account) — the place a real leak would hide."
        },
        "session_modes": {
          "type": "object",
          "description": "group -> data|report mode, for the shared store check.",
          "additionalProperties": {
            "enum": [
              "data",
              "report"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "description": "Assertions for the evaluator. Numbers here are golden values, never copied from a model run. The key allowlist is closed so a misspelled assertion fails loudly instead of being silently ignored.",
      "properties": {
        "activities": {
          "type": "array"
        },
        "activity_code": {
          "type": "string"
        },
        "agg_column": {
          "type": "string"
        },
        "agg_type": {
          "type": "string"
        },
        "aliases": {
          "type": "array"
        },
        "allowed_numbers": {
          "type": "array"
        },
        "allowed_tables": {
          "type": "array"
        },
        "allowed_tools": {
          "type": "array"
        },
        "anchors": {
          "type": "array"
        },
        "anchors_contains": {
          "type": "array"
        },
        "attributes": {
          "type": "array"
        },
        "business_objects": {
          "type": "array"
        },
        "chart_files": {
          "type": "object"
        },
        "checks": {
          "type": "array"
        },
        "code": {
          "type": "string"
        },
        "context": {
          "type": "object"
        },
        "context_contract": {
          "type": "object"
        },
        "definition_contains": {
          "type": "array"
        },
        "dimensions": {
          "type": "array"
        },
        "dimensions_contains": {
          "type": "array"
        },
        "dimensions_excludes": {
          "type": "array"
        },
        "english": {
          "type": "string"
        },
        "error_contains": {
          "type": "array"
        },
        "escaped": {
          "type": "boolean"
        },
        "filter_condition": {
          "type": "string"
        },
        "filters": {
          "type": "array"
        },
        "final_narrative": {
          "type": "boolean"
        },
        "final_text_absent": {
          "type": "array"
        },
        "final_text_contains": {
          "type": "array"
        },
        "forbidden_filters": {
          "type": "array"
        },
        "forbidden_substrings": {
          "type": "array"
        },
        "foreign_keys": {
          "type": "object"
        },
        "grounding": {
          "type": "boolean"
        },
        "intent_level": {
          "type": "string"
        },
        "le_code": {
          "type": "string"
        },
        "logical_entities": {
          "type": "array"
        },
        "metric": {
          "type": "string"
        },
        "metrics": {
          "type": "array"
        },
        "missing": {
          "type": "array"
        },
        "must_contain": {
          "type": "array"
        },
        "must_not_appear": {
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "physical_table": {
          "type": "string"
        },
        "policy": {
          "type": [
            "object",
            "string"
          ],
          "description": "Cognitive Policy assertions. Refusal cases additionally pin refusal_category and require the secret-free refusal_message.",
          "properties": {
            "mode": {
              "type": "string"
            },
            "mode_not_in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason_code": {
              "type": "string"
            },
            "next_step": {
              "type": "string"
            },
            "required_tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_tools_empty": {
              "type": "boolean"
            },
            "evidence_required": {
              "type": "boolean"
            },
            "needs_human": {
              "type": "boolean"
            },
            "refusal_category": {
              "enum": [
                "credential_exfiltration",
                "environment_discovery",
                "destructive_data_operation"
              ]
            },
            "refusal_category_absent": {
              "type": "boolean",
              "description": "The mirrors of refusal_category: the turn must NOT be a refusal (constraint statements, safety-guidance questions)."
            },
            "refusal_message_required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "policy_mode": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "query_contract": {
          "type": "object"
        },
        "reason_contains": {
          "type": "array"
        },
        "recovery_status": {
          "type": "string"
        },
        "relation_codes": {
          "type": "array"
        },
        "relations": {
          "type": "array"
        },
        "required_filters": {
          "type": "array"
        },
        "rows": {
          "type": "array"
        },
        "rule_codes": {
          "type": "array"
        },
        "rules": {
          "type": "array"
        },
        "scope_contains": {
          "type": "array"
        },
        "scope_note": {
          "type": "string"
        },
        "skip": {
          "type": "boolean"
        },
        "table": {
          "type": "string"
        },
        "targets": {
          "type": "array"
        },
        "terms": {
          "type": "array"
        },
        "tolerance": {
          "type": "number"
        },
        "tool_chain": {
          "type": "array"
        },
        "tool_inputs": {
          "type": "object"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_results": {
          "type": "object"
        },
        "tool_status": {
          "type": "object"
        },
        "unit": {
          "type": "string"
        },
        "unsupported_numbers": {
          "type": "array"
        },
        "valid": {
          "type": "boolean"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_is_null": {
          "type": "boolean"
        },
        "wants_action": {
          "type": "boolean"
        },
        "wants_root_cause": {
          "type": "boolean"
        },
        "wants_forecast": {
          "type": "boolean",
          "description": "The turn asks for a prediction / scenario projection (additive batch-5 flag)."
        },
        "forecast_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "stored_forecast",
            "predictive_forecast",
            "scenario_projection",
            null
          ],
          "description": "Which forecast contract the turn belongs to; null when the turn is not a forecast."
        },
        "forbidden_context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Context keys the peer session must NOT inherit."
        },
        "group_history_contains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Earlier turns (matched by question text) that must still be present, in order, in a shared conversation group."
        }
      },
      "additionalProperties": false
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Observable regressions that must NOT appear. Semantic labels only; never raw answer text."
    },
    "allowed_variants": {
      "type": "object"
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scoring": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "known_gap": {
      "type": "boolean",
      "description": "Red test for a real defect. Excluded from pass rates, metrics and gates; reported as known_gap_xfail / known_gap_xpass."
    },
    "gap_note": {
      "type": "string",
      "description": "Required when known_gap is true: what the product does today and why that is a defect."
    },
    "gap_meta": {
      "type": "object",
      "description": "Required for known_gap cases: owner, introduced_at, target_fix_version, severity and source_issue.",
      "required": [
        "owner",
        "introduced_at",
        "target_fix_version",
        "severity",
        "source_issue",
        "production_entry"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "introduced_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_fix_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "source_issue": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "production_entry": {
          "type": "string",
          "minLength": 1,
          "description": "The production entry point whose behaviour this Red test pins."
        }
      }
    },
    "answer_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Answer-level rules scored by score_answer (action section, proxy disclosure, correlation vs causation, ...)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "recorded_provider",
              "answer_grounding",
              "generated_sql",
              "tool_chain"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "provider"
            ]
          }
        }
      },
      "description": "these evaluators replay a recorded provider transcript"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "sql"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "sql"
            ]
          }
        }
      },
      "description": "the sql evaluator executes one reference query"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "sql_guard"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "sql"
            ]
          }
        }
      },
      "description": "the guard needs the SQL text it must reject or accept"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "ontology"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "ontology"
            ]
          }
        }
      },
      "description": "the ontology evaluator needs the workbook fixture"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "session_isolation",
              "recovery_state"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "script"
            ]
          }
        }
      },
      "description": "these evaluators drive a scripted operator"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "admission"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "principals",
              "env"
            ]
          }
        }
      },
      "description": "the admission evaluator needs the principal set"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "chart_validate",
              "chart_policy"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "chart_params"
            ]
          }
        }
      },
      "description": "chart cases must declare the parameters they validate"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "context_resolution"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "previous",
              "changes"
            ]
          }
        }
      },
      "description": "context cases declare the inherited context and the follow-up change"
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "enum": [
              "recorded_session_isolation"
            ]
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "sessions"
            ]
          }
        }
      },
      "description": "cross-session sentinels replay two or more sessions"
    }
  ]
}
