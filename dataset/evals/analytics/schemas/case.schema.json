{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://boulderaitech.local/eimosp-ontology-agentic-analytics/analytics-eval-case.schema.json",
  "title": "Analytics golden-set case",
  "description": "One natural-language -> intent -> contract -> query -> number -> evidence -> chart -> answer contract. Cases are generated by dataset/evals/analytics/build_cases.py; the JSON is committed so a reviewer can read a single case without running anything.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "version", "priority", "suite", "domain", "category",
    "evaluator", "question", "conversation", "context", "fixture",
    "expected", "forbidden", "evidence_requirements", "tags"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^ANA-[A-Z0-9]+-[0-9]{3}$",
      "description": "Stable identity. Never renumber an existing case; add a new one instead."
    },
    "version": {"type": "integer", "minimum": 1},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "suite": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["smoke", "regression", "multi-turn", "ontology", "charts",
                 "adversarial", "recovery", "diagnosis", "live"]
      },
      "uniqueItems": true
    },
    "domain": {"enum": ["采购", "库存", "销售", "财务", "质量", "制造", "通用"]},
    "category": {
      "enum": ["intent", "facts", "metrics", "comparison", "trend", "anomaly",
               "diagnosis", "recommendation", "ontology", "multi_turn", "charts",
               "failure_recovery", "adversarial"]
    },
    "evaluator": {
      "enum": ["policy", "sql", "ontology", "multi_turn", "chart_validate",
               "chart_policy", "chart_html_safety", "sql_guard", "recovery_state",
               "admission", "session_isolation", "live"]
    },
    "question": {"type": "string", "minLength": 1},
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "time_range": {"type": "object"},
        "organization": {"type": "array"},
        "currency": {"type": "string"},
        "unit": {"type": "string"}
      }
    },
    "fixture": {
      "type": "object",
      "description": "Declarative inputs for the evaluator. Must reference only files under dataset/evals/analytics/fixtures/.",
      "properties": {
        "db": {"type": "string", "description": "SQLite fixture name, opened read-only (mode=ro&immutable=1)."},
        "sql": {"type": "string", "description": "Reference query. Must not contain DDL/DML."},
        "ontology": {"type": "string"},
        "script": {"type": "array"},
        "env": {"type": "object"},
        "principals": {"type": "object"},
        "previous_contract": {"type": "object"},
        "resolution": {"type": "object"},
        "resolved_contract": {"type": "object"},
        "effective_question": {"type": "string"},
        "follow_up_question": {"type": "string"},
        "resolved_question": {"type": "string"},
        "chart": {"type": "object"},
        "html": {"type": "string"},
        "rows": {"type": "array"},
        "columns": {"type": "array"}
      }
    },
    "expected": {
      "type": "object",
      "description": "Assertions for the evaluator. Numbers here are golden values."
    },
    "forbidden": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Observable regressions that must NOT appear. Semantic labels only; never raw answer text."
    },
    "allowed_variants": {"type": "object"},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "scoring": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "summary": {"type": "string"},
    "notes": {"type": "string"},
    "known_gap": {
      "type": "boolean",
      "description": "Red test for a real defect. Excluded from pass rates, metrics and gates; reported as known_gap_xfail / known_gap_xpass."
    },
    "gap_note": {
      "type": "string",
      "description": "Required when known_gap is true: what the product does today and why that is a defect."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"known_gap": {"const": true}}, "required": ["known_gap"]},
      "then": {"required": ["gap_note"]}
    },
    {
      "if": {"properties": {"evaluator": {"const": "sql"}}, "required": ["evaluator"]},
      "then": {
        "properties": {
          "fixture": {"required": ["db", "sql"]}
        }
      }
    },
    {
      "if": {"properties": {"evaluator": {"const": "multi_turn"}}, "required": ["evaluator"]},
      "then": {
        "properties": {
          "fixture": {"required": ["effective_question", "previous_contract", "resolved_contract"]}
        }
      }
    }
  ]
}
