{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://boulderaitech.local/eimosp-ontology-agentic-analytics/analytics-eval-case.schema.json",
  "title": "Analytics golden-set case",
  "description": "One natural-language -> intent -> contract -> query -> number -> evidence -> chart -> answer contract. Cases are generated by dataset/evals/analytics/build_cases.py; the JSON is committed so a reviewer can read a single case without running anything. Unknown top-level fields are rejected (build_cases fails, and the runner marks the case failed) so a misspelled key can never be silently ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "version",
    "priority",
    "suite",
    "domain",
    "category",
    "evaluator",
    "question",
    "conversation",
    "context",
    "fixture",
    "expected",
    "forbidden",
    "evidence_requirements",
    "tags"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^ANA-[A-Z0-9]+-[0-9]{3}$",
      "description": "Stable identity. Never renumber an existing case; add a new one instead."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "suite": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "smoke",
          "regression",
          "multi-turn",
          "ontology",
          "charts",
          "adversarial",
          "recovery",
          "diagnosis",
          "recorded-provider",
          "live"
        ]
      },
      "uniqueItems": true
    },
    "domain": {
      "enum": [
        "采购",
        "库存",
        "销售",
        "财务",
        "质量",
        "制造",
        "通用"
      ]
    },
    "category": {
      "enum": [
        "intent",
        "facts",
        "metrics",
        "comparison",
        "trend",
        "anomaly",
        "diagnosis",
        "recommendation",
        "ontology",
        "multi_turn",
        "charts",
        "failure_recovery",
        "adversarial"
      ]
    },
    "evaluator": {
      "enum": [
        "policy",
        "sql",
        "ontology",
        "multi_turn",
        "chart_validate",
        "chart_policy",
        "chart_html_safety",
        "sql_guard",
        "recovery_state",
        "admission",
        "session_isolation",
        "live",
        "recorded_provider",
        "generated_sql",
        "tool_chain",
        "answer_grounding",
        "context_resolution"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "time_range": {
          "type": "object"
        },
        "organization": {
          "type": "array"
        },
        "currency": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "fixture": {
      "type": "object",
      "description": "Declarative inputs for the evaluator. Must reference only files under dataset/evals/analytics/fixtures/.",
      "properties": {
        "db": {
          "type": "string",
          "description": "SQLite fixture name, opened read-only (mode=ro&immutable=1)."
        },
        "sql": {
          "type": "string",
          "description": "Reference query. Must not contain DDL/DML."
        },
        "ontology": {
          "type": "string"
        },
        "script": {
          "type": "array"
        },
        "env": {
          "type": "object"
        },
        "principals": {
          "type": "object"
        },
        "previous_contract": {
          "type": "object"
        },
        "resolution": {
          "type": "object"
        },
        "resolved_contract": {
          "type": "object"
        },
        "effective_question": {
          "type": "string"
        },
        "follow_up_question": {
          "type": "string"
        },
        "resolved_question": {
          "type": "string"
        },
        "chart": {
          "type": "object"
        },
        "html": {
          "type": "string"
        },
        "rows": {
          "type": "array"
        },
        "columns": {
          "type": "array"
        },
        "provider": {
          "type": "string",
          "description": "Recorded-provider transcript, relative to dataset/evals/analytics/. Replayed through the production turn loop; no model call is made."
        },
        "reference_sql": {
          "type": "string",
          "description": "Reference query for generated_sql cases, executed read-only alongside the SQL the agent actually issued."
        },
        "tools_override": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous": {
          "type": "object",
          "description": "Inherited AnalysisContext (context_resolution)."
        },
        "changes": {
          "type": "object",
          "description": "Explicit scope changes the follow-up states (context_resolution)."
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "description": "Assertions for the evaluator. Numbers here are golden values."
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Observable regressions that must NOT appear. Semantic labels only; never raw answer text."
    },
    "allowed_variants": {
      "type": "object"
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scoring": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "known_gap": {
      "type": "boolean",
      "description": "Red test for a real defect. Excluded from pass rates, metrics and gates; reported as known_gap_xfail / known_gap_xpass."
    },
    "gap_note": {
      "type": "string",
      "description": "Required when known_gap is true: what the product does today and why that is a defect."
    },
    "gap_meta": {
      "type": "object",
      "description": "Required for known_gap cases: owner, introduced_at, target_fix_version, severity and source_issue.",
      "required": [
        "owner",
        "introduced_at",
        "target_fix_version",
        "severity",
        "source_issue"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "introduced_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_fix_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "source_issue": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "answer_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Answer-level rules scored by score_answer (action section, proxy disclosure, correlation vs causation, ...)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "known_gap": {
            "const": true
          }
        },
        "required": [
          "known_gap"
        ]
      },
      "then": {
        "required": [
          "gap_note",
          "gap_meta"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "sql"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "db",
              "sql"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "multi_turn"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "effective_question",
              "previous_contract",
              "resolved_contract"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "context_resolution"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "previous",
              "changes"
            ]
          },
          "expected": {
            "required": [
              "context"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "recorded_provider"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "provider",
              "db"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "tool_chain"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "provider",
              "db"
            ]
          },
          "expected": {
            "required": [
              "tool_chain"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "answer_grounding"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "provider",
              "db"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "generated_sql"
          }
        },
        "required": [
          "evaluator"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "required": [
              "provider",
              "db"
            ]
          },
          "expected": {
            "required": [
              "allowed_tables",
              "tool_chain"
            ]
          }
        }
      }
    }
  ]
}
