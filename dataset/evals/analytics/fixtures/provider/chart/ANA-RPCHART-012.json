  "case_id": "ANA-RPCHART-012",
  "turns": [
    {
      "user": "画库存月度趋势，缺月不补零",
      "db": "inventory.db",
      "events": [
        {
          "type": "tool_start",
          "name": "Ontology-FactQuery",
          "input": {
            "sql": "SELECT snapshot_month AS m, SUM(on_hand_qty) AS v FROM fact_inventory_snapshot GROUP BY snapshot_month ORDER BY m",
            "query_description": "画库存月度趋势，缺月不补零"
          }
        },
        {
          "type": "tool_start",
          "name": "TableGenerate",
          "input": {
            "title": "库存月度",
            "columns": [
              {
                "key": "m",
                "label": "月份"
              },
              {
                "key": "v",
                "label": "数量"
              }
            ],
            "rows": [
              [
                "2025-01",
                240
              ]
            ]
          }
        },
        {
          "type": "tool_start",
          "name": "ChartGenerate",
          "input": {
            "chart_type": "line",
            "title": "库存数量月度趋势（仅已发生快照）",
            "x_axis": [
              "2025-01"
            ],
            "series": [
              {
                "name": "库存数量",
                "data": [
                  240
                ]
              }
            ],
            "source_note": "fact_inventory_snapshot · 不补零，缺失月不绘制"
          }
        },
        {
          "type": "text_delta",
          "text": "不补零口径下只绘制真实存在的月份，当前仅 2025-01，数量 240；缺失月份不在图中以 0 出现。"
        },
        {
          "type": "done"
        }
      ]
    }
  ]
}
