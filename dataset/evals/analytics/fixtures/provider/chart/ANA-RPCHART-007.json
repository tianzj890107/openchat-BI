{
  "version": 1,
  "provider": "recorded",
  "case_id": "ANA-RPCHART-007",
  "turns": [
    {
      "user": "把采购金额和订单数放在同一张图里",
      "db": "procurement.db",
      "events": [
        {
          "type": "tool_start",
          "name": "Ontology-FactQuery",
          "input": {
            "sql": "SELECT order_month AS m, SUM(amount) AS v, COUNT(*) AS c FROM fact_purchase_order WHERE is_deleted = 0 GROUP BY order_month ORDER BY m",
            "query_description": "把采购金额和订单数放在同一张图里"
          }
        },
        {
          "type": "tool_start",
          "name": "TableGenerate",
          "input": {
            "title": "金额与订单数",
            "columns": [
              {
                "key": "m",
                "label": "月份"
              },
              {
                "key": "v",
                "label": "金额"
              },
              {
                "key": "c",
                "label": "订单数"
              }
            ],
            "rows": [
              [
                "2025-01",
                4700,
                4
              ],
              [
                "2025-02",
                6400,
                4
              ]
            ]
          }
        },
        {
          "type": "tool_start",
          "name": "ChartGenerate",
          "input": {
            "chart_type": "line",
            "title": "采购金额与订单数（双单位，已拆分）",
            "x_axis": [
              "2025-01",
              "2025-02"
            ],
            "series": [
              {
                "name": "采购金额(元)",
                "data": [
                  4700,
                  6400
                ]
              }
            ],
            "unit": "元",
            "source_note": "MT-001 · fact_purchase_order · 仅金额在主轴"
          }
        },
        {
          "type": "text_delta",
          "text": "金额与订单数单位不同，未放在同一坐标轴；图中只保留金额，订单数另见表格。"
        },
        {
          "type": "done"
        }
      ]
    }
  ]
}
