# ontology-analytics 真实工具配置模板
# 用法：复制为 tools/credentials.env 或 ~/.config/ontology-analytics/credentials.env，再填入真实值。
# 本模板不含任何真实凭据；credentials.env 已被 .gitignore 忽略，禁止提交或外发。

# ---- 本体（远程，生产模式）----
ONTOLOGY_BACKEND=production
ONTOLOGY_BASE_URL=
ONTOLOGY_REPOSITORY_ID=
ONTOLOGY_APP_ID=
ONTOLOGY_AUTH_TOKEN=
ONTOLOGY_NAMESPACE=
ONTOLOGY_TIMEOUT_SECONDS=30

# ---- 本体（本地 Excel，离线调试，二选一）----
# ONTOLOGY_BACKEND=local
# OA_LOCAL_ONTOLOGY_XLSX=/path/to/ontology.xlsx

# ---- 取数后端（Doris HTTP 网关，推荐）----
DORIS_API_URL=
DORIS_DATABASE=

# ---- 取数后端（Doris MySQL 协议，可选，需 pip install pymysql）----
# DORIS_JDBC_URL=jdbc:mysql://host:9030/database
# DORIS_USERNAME=
# DORIS_PASSWORD=

# ---- 取数后端（本地 SQLite，离线自检用）----
# OA_SQLITE_DB=/path/to/demo.sqlite3

# ---- x360 流程/预警（可选）----
X360_ENABLED=false
X360_BASE_URL=
X360_APP_ID=
X360_AUTH_TOKEN=
X360_PROCESS_DEFINITION_KEY=
X360_PROCESS_DEFINITION_ID=
X360_TIMEOUT_SECONDS=30
